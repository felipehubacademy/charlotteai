# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# API Charlotte (Next.js no Vercel)
EXPO_PUBLIC_API_BASE_URL=https://your-api.vercel.app

# EAS Build
EAS_PROJECT_ID=your-eas-project-id

# Sentry — runtime DSN (público, exposto em expoConfig.extra)
EXPO_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/YYY

# Sentry — build-time (apenas EAS / CI / dev local pra upload de sourcemaps)
# NÃO commitar valores reais — fica em .env local ou eas.json com "secret".
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=
